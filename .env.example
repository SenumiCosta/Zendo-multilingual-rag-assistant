# Environment variables for the Zendo multilingual RAG assistant.
# Copy to `.env` and fill in HUGGINGFACE_TOKEN.

# --- LLM (HuggingFace Inference API) ---
# Pick any "warm" chat model:
#   https://huggingface.co/models?inference=warm&pipeline_tag=text-generation
# Known-working examples (as of 2026; availability changes):
#   Qwen/Qwen2.5-7B-Instruct         (ungated, multilingual)
#   HuggingFaceH4/zephyr-7b-beta     (ungated)
#   meta-llama/Llama-3.1-8B-Instruct (gated — accept license first)
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# Get a free Read token: https://huggingface.co/settings/tokens
HUGGINGFACE_TOKEN=your_token_here

# Optional: force a specific Inference Provider when auto-routing fails.
# Leave blank to let HuggingFace pick one.
# Examples: hf-inference, together, fireworks-ai, cerebras, nebius
# LLM_PROVIDER=

# --- Embeddings ---
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Paths ---
VECTOR_DB_PATH=./data/vector_db
DOCUMENTS_PATH=./data/documents
